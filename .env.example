SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=pmv_ergonomia
MYSQL_PORT=3306

# Cuenta Owner inicial (si dejas OWNER_PASSWORD vacío se genera una y se imprime en consola)
OWNER_USERNAME=owner
OWNER_PASSWORD=
OWNER_EMAIL=

# Pon HTTPS=1 cuando la web se sirva con https (cookies seguras)
HTTPS=0

# IA para sugerir puntos y ángulos en fotos (opcional; sin clave se marcan a mano)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Carpeta de fotos (fuera de static; haz copia de seguridad)
UPLOAD_DIR=
# Agenda: antelación mínima para reservar una visita (horas)
MIN_ANTICIPACION_HORAS=2
TIMEZONE=America/Bogota

# Producción detrás de proxy (Render, AWS, Nginx)
BEHIND_PROXY=0
# Bases MySQL administradas: MYSQL_SSL=1 (y MYSQL_SSL_CA si el proveedor da un certificado)
MYSQL_SSL=0
MYSQL_SSL_CA=
